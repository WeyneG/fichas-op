{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!css/|js/|icons/|img/|manifest\\.webmanifest|favicon).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
